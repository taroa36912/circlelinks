rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function userRole(uid) {
      return isSignedIn() && uid != null
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : null;
    }

    function isStudentUser() {
      return isSignedIn() && userRole(request.auth.uid) == 'student';
    }

    function isAdmin(circleId) {
      return isSignedIn() 
        && circleId != null 
        && circleId is string
        && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function isConnectionChatParticipant(chatId) {
      return exists(/databases/$(database)/documents/connectionRequests/$(chatId)) && (
        isAdmin(get(/databases/$(database)/documents/connectionRequests/$(chatId)).data.fromCircleId) ||
        isAdmin(get(/databases/$(database)/documents/connectionRequests/$(chatId)).data.toCircleId)
      );
    }

    match /circles/{circleId} {
      allow read: if isSignedIn();
      allow create: if isStudentUser();
      allow update, delete: if isAdmin(circleId);

      match /members/{memberId} {
        allow read: if isSignedIn() && (request.auth.uid == memberId || isAdmin(circleId));
        allow create: if isAdmin(circleId) || (
          isSignedIn() && 
          request.auth.uid == memberId && 
          request.resource.data.role == 'admin' &&
          !exists(/databases/$(database)/documents/circles/$(circleId))
        );
        allow update, delete: if isAdmin(circleId);
      }
    }

    match /{path=**}/members/{memberDocId} {
      allow read: if isSignedIn() && (
        request.auth.uid == memberDocId || 
        resource.data.userId == request.auth.uid
      );
    }

    match /connectionRequests/{reqId} {
      allow read: if isSignedIn() && (
        ('fromCircleId' in resource.data && isAdmin(resource.data.fromCircleId)) || 
        ('toCircleId' in resource.data && isAdmin(resource.data.toCircleId))
      );
      allow create: if isSignedIn() && 'fromCircleId' in request.resource.data && isAdmin(request.resource.data.fromCircleId);
      allow update, delete: if isSignedIn() && (
        ('fromCircleId' in resource.data && isAdmin(resource.data.fromCircleId)) || 
        ('toCircleId' in resource.data && isAdmin(resource.data.toCircleId))
      );
    }
    
    match /chats/{chatId} {
      allow read, update, delete: if isSignedIn() && isConnectionChatParticipant(chatId);
      allow create: if isSignedIn();
      
      match /messages/{msgId} {
        allow read, create: if isSignedIn() && isConnectionChatParticipant(chatId);
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }

    match /dm_channels/{channelId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.individualId || 
        ('circleId' in resource.data && isAdmin(resource.data.circleId))
      );
      allow create: if isStudentUser() && (
        request.auth.uid == request.resource.data.individualId || 
        ('circleId' in request.resource.data && isAdmin(request.resource.data.circleId))
      );
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.individualId || 
        ('circleId' in resource.data && isAdmin(resource.data.circleId))
      );
      
      match /dm_messages/{msgId} {
        allow read: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/dm_channels/$(channelId)).data.individualId || 
          ('circleId' in get(/databases/$(database)/documents/dm_channels/$(channelId)).data && isAdmin(get(/databases/$(database)/documents/dm_channels/$(channelId)).data.circleId))
        );
        allow create: if isStudentUser() && (
          request.auth.uid == get(/databases/$(database)/documents/dm_channels/$(channelId)).data.individualId || 
          ('circleId' in get(/databases/$(database)/documents/dm_channels/$(channelId)).data && isAdmin(get(/databases/$(database)/documents/dm_channels/$(channelId)).data.circleId))
        );
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 'circleId' in request.resource.data && isAdmin(request.resource.data.circleId);
      allow update, delete: if isSignedIn() && 'circleId' in resource.data && isAdmin(resource.data.circleId);

      match /attendances/{attendanceUserId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == attendanceUserId;
      }
    }
  }
}